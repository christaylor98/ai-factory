# Example .env file for ai-factory
#
# Place this file at:
#   - ~/.aifactory/.env (global)
#   - ./.env (project root)
#
# Never commit this file to version control!
# Add .env to your .gitignore

# ═══════════════════════════════════════════════════════════════
# API Keys (choose the providers you use)
# ═══════════════════════════════════════════════════════════════

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-key-here

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-key-here


# ═══════════════════════════════════════════════════════════════
# Optional: Configuration Overrides
# ═══════════════════════════════════════════════════════════════
# These override config files but are overridden by CLI args

# AIFACTORY_PROVIDER=gemini
# AIFACTORY_MODEL=gemini-2.5-flash
# AIFACTORY_MAX_RETRIES=3
# AIFACTORY_BACKOFF_BASE_MS=250
# AIFACTORY_BACKOFF_MULTIPLIER=2.0

# AIFACTORY_LEDGER_ENABLED=true
# AIFACTORY_LEDGER_PATH=./LEDGER.is
# AIFACTORY_CAPTURE_PROMPT=false
# AIFACTORY_CAPTURE_OUTPUT=false
# AIFACTORY_CAPTURE_LIMIT_CHARS=20000


# ═══════════════════════════════════════════════════════════════
# Provider-Specific Settings
# ═══════════════════════════════════════════════════════════════

# OpenRouter optional headers
# OPENROUTER_HTTP_REFERER=https://your-app.com
# OPENROUTER_X_TITLE=Your App Name
